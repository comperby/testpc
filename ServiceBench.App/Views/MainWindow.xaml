<Window x:Class="ServiceBench.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ServiceBench.App.ViewModels"
        Title="ServiceBench — автоматизированный стенд"
        Height="740" Width="1120"
        mc:Ignorable="d">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ServiceBench — автоматизированный стенд"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,12,0">
                <StackPanel>
                    <GroupBox Header="Выбор программ" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Margin="12,8,12,8">
                            <CheckBox Content="AIDA64" IsChecked="{Binding Plan.UseAida}" Margin="0,0,16,0"/>
                            <CheckBox Content="OCCT" IsChecked="{Binding Plan.UseOcct}" Margin="0,0,16,0"/>
                            <CheckBox Content="FurMark" IsChecked="{Binding Plan.UseFurmark}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="AIDA64 SST" Margin="0,0,0,12">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <CheckBox Content="CPU" IsChecked="{Binding Plan.AidaCpu}"/>
                                <CheckBox Content="FPU" IsChecked="{Binding Plan.AidaFpu}"/>
                                <CheckBox Content="Stress cache" IsChecked="{Binding Plan.AidaCache}"/>
                                <CheckBox Content="Stress system memory" IsChecked="{Binding Plan.AidaMemory}"/>
                                <CheckBox Content="Stress local disks" IsChecked="{Binding Plan.AidaDisk}"/>
                                <CheckBox Content="Stress GPU" IsChecked="{Binding Plan.AidaGpu}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Grid.Column="1"
                                        Margin="20,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Длительность (мин):"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBox Width="60" Text="{Binding Plan.AidaDurationMinutes}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="OCCT 14.2.6 — профили" Margin="0,0,0,12">
                        <StackPanel Margin="12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <CheckBox Content="CPU Small (AVX2 ON)" IsChecked="{Binding Plan.OcctCpuSmall}" Width="220"/>
                                <TextBlock Text="Длительность (мин):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Width="60" Text="{Binding Plan.OcctCpuMinutes}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <CheckBox Content="GPU 3D" IsChecked="{Binding Plan.OcctGpu3D}" Width="220"/>
                                <TextBlock Text="Длительность (мин):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Width="60" Text="{Binding Plan.OcctGpuMinutes}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="VRAM" IsChecked="{Binding Plan.OcctVram}" Width="220"/>
                                <TextBlock Text="Длительность (мин):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Width="60" Text="{Binding Plan.OcctVramMinutes}"/>
                            </StackPanel>
                            <TextBlock Text="Задержка между профилями: 10 секунд"
                                       Foreground="#888"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="FurMark 2.9.0.0" Margin="0,0,0,12">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Пресет разрешения:"/>
                                <ComboBox ItemsSource="{Binding FurmarkPresets}"
                                          SelectedItem="{Binding Plan.SelectedFurmarkPreset}"
                                          Width="200"/>
                                <CheckBox Content="Custom"
                                          IsChecked="{Binding Plan.FurmarkCustom}"
                                          Margin="0,10,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Ширина:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="60" Text="{Binding Plan.FurmarkWidth}" IsEnabled="{Binding Plan.FurmarkCustom}"/>
                                    <TextBlock Text="Высота:" VerticalAlignment="Center" Margin="20,0,8,0"/>
                                    <TextBox Width="60" Text="{Binding Plan.FurmarkHeight}" IsEnabled="{Binding Plan.FurmarkCustom}"/>
                                </StackPanel>
                                <CheckBox Content="Fullscreen" IsChecked="{Binding Plan.FurmarkFullscreen}" Margin="0,10,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Grid.Column="1"
                                        Margin="20,0,0,0"
                                        VerticalAlignment="Top">
                                <TextBlock Text="Длительность (мин):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Width="60" Text="{Binding Plan.FurmarkMinutes}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Режим прогона и опции" Margin="0,0,0,12">
                        <StackPanel Margin="12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Тег:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="150"
                                          SelectedValuePath="Content"
                                          SelectedValue="{Binding RunTag}">
                                    <ComboBoxItem Content="before" />
                                    <ComboBoxItem Content="after" />
                                    <ComboBoxItem Content="custom" />
                                </ComboBox>
                                <TextBox Width="150"
                                         Margin="10,0,0,0"
                                         Text="{Binding CustomRunTag}"
                                         IsEnabled="{Binding IsCustomTag}"/>
                            </StackPanel>
                            <CheckBox Content="Сохранять CSV AIDA" IsChecked="{Binding Plan.SaveAidaCsv}" Margin="0,0,0,6"/>
                            <CheckBox Content="Сжатие скриншотов" IsChecked="{Binding Plan.CompressScreenshots}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Лог" Margin="0,0,0,12">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Статус:" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <TextBox Grid.Row="2"
                                     Text="{Binding LogText}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Height="160"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" MinWidth="420">
                <Border Padding="12"
                        BorderBrush="#DDD"
                        BorderThickness="1"
                        CornerRadius="8"
                        x:Name="LivePanel"
                        HorizontalAlignment="Stretch"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">
                    <DockPanel LastChildFill="True">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button Content="Старт" Command="{Binding StartCommand}" Width="120" Margin="0,0,8,0"/>
                            <Button Content="СТОП (Esc)" Command="{Binding StopCommand}" Width="120" Margin="0,0,8,0"/>
                            <Button Content="Открыть папку устройства" Command="{Binding OpenDeviceFolderCommand}" Margin="0,0,8,0"/>
                            <Button Content="Открыть дашборд" Command="{Binding OpenDashboardCommand}" Margin="0,0,8,0"/>
                            <Button Content="Настройки" Command="{Binding OpenSettingsCommand}"/>
                        </StackPanel>

                        <Separator Margin="0,0,0,8"/>

                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Текущий статус:" FontWeight="SemiBold"/>
                            <ScrollViewer Margin="0,4,0,0"
                                          MaxHeight="160"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Text="{Binding Status, TargetNullValue=-}"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </StackPanel>

                        <Separator Margin="0,8,0,8"/>

                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Телеметрия (live)" FontWeight="SemiBold" Margin="0,8,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU °C:"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LiveCpuTemp, TargetNullValue=-}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="GPU °C:"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LiveGpuTemp, TargetNullValue=-}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="CPU MHz:"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LiveCpuFreq, TargetNullValue=-}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="GPU Core MHz:"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LiveGpuCore, TargetNullValue=-}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="GPU Mem MHz:"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LiveGpuMem, TargetNullValue=-}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="CPU Fan RPM:"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LiveCpuFan, TargetNullValue=-}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="GPU Fan:"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text">
                                                <Setter.Value>
                                                    <Binding Path="LiveGpuFan" TargetNullValue="-"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LiveGpuFan}" Value="{x:Null}">
                                                    <Setter Property="Text">
                                                        <Setter.Value>
                                                            <Binding Path="LiveGpuFanPct" StringFormat="{}{0}%" TargetNullValue="-"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Text="Esc — экстренный стоп" HorizontalAlignment="Right" FontStyle="Italic" Margin="0,12,0,0"/>
    </Grid>
</Window>
