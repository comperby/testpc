<Window x:Class="ServiceBench.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ServiceBench.App.ViewModels"
        Title="Настройки ServiceBench" Height="500" Width="600" mc:Ignorable="d">
    <Window.DataContext>
        <vm:SettingsViewModel />
    </Window.DataContext>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GroupBox Header="Пути к утилитам" Margin="0 0 0 10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="AIDA64:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Margin="10 0" Text="{Binding Settings.AidaPath}"/>
                <Button Grid.Column="2" Content="..." Width="30" Command="{Binding BrowseAidaCommand}"/>

                <TextBlock Grid.Row="1" Text="OCCT:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="10 0" Text="{Binding Settings.OcctPath}"/>
                <Button Grid.Row="1" Grid.Column="2" Content="..." Width="30" Command="{Binding BrowseOcctCommand}"/>

                <TextBlock Grid.Row="2" Text="FurMark:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="10 0" Text="{Binding Settings.FurmarkPath}"/>
                <Button Grid.Row="2" Grid.Column="2" Content="..." Width="30" Command="{Binding BrowseFurmarkCommand}"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Брендинг" Margin="0 0 0 10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Название организации:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Margin="10 0" Text="{Binding Settings.Brand.CompanyName}"/>
                <TextBlock Grid.Row="1" Text="Адрес:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="10 0" Text="{Binding Settings.Brand.Address}"/>
                <TextBlock Grid.Row="2" Text="Режим работы:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="10 0" Text="{Binding Settings.Brand.WorkingHours}"/>
                <TextBlock Grid.Row="3" Text="Логотип:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Width="350" Text="{Binding Settings.Brand.LogoPath}"/>
                    <Button Content="..." Width="30" Margin="10 0" Command="{Binding BrowseLogoCommand}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Отмена" Width="100" Command="{Binding CancelCommand}"/>
            <Button Content="Сохранить" Width="120" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
